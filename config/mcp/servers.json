{
  "_meta": {
    "modelscope": "https://modelscope.cn/mcp/servers/@microsoft/playwright-mcp",
    "upstream": "https://github.com/microsoft/playwright-mcp",
    "npm": "@playwright/mcp@latest",
    "note": "Playwright MCP 经 scripts/playwright-mcp.sh 启动（Windows 同步时改用同名 .cmd）；sync 写入本机绝对路径"
  },
  "servers": {
    "playwright": {
      "enabled": true,
      "wrapper": "scripts/playwright-mcp.sh",
      "args": [
        "--browser",
        "chrome",
        "--timeout-navigation",
        "60000",
        "--timeout-action",
        "60000"
      ]
    }
  }
}
